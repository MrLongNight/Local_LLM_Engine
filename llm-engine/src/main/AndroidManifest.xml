<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <!-- Separate app-private process for native LLM execution. isolatedProcess=false keeps the same app UID; this is process/crash separation, not a separate-UID security sandbox. -->
        <service
            android:name="com.mydocanizer.llm.engine.ipc.InferenceService"
            android:process=":inference"
            android:exported="false"
            android:isolatedProcess="false" />
    </application>

</manifest>
